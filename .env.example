# Copy this file to .env and fill in ONLY the key(s) you use. Never commit .env.

# ===== interview_coach/ package (cli.py, demo.py) =====
# Pick ONE provider: gemini (default, free tier) | groq (free tier) | ollama (local, free) | openai (paid, cheap)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the provider's default model without touching code.
#LLM_MODEL=gemini-2.5-flash-lite

# ===== src/ package (main.py) =====
# main.py uses OpenAI directly (or --mock for no API calls).
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
MAX_QUESTIONS=3
TEMPERATURE=0.3

# ===== Shared token-budget knobs =====
CONTEXT_LIMIT=8000
COMPLETION_RESERVE=1000
